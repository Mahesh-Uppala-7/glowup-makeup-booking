# ---- Server ----
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Comma-separated list of allowed origins for CORS (Expo web, device, etc.)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# ---- Database (PostgreSQL) ----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/makeup_app?schema=public

# ---- Auth / JWT ----
JWT_ACCESS_SECRET=replace_with_a_long_random_string_access
JWT_REFRESH_SECRET=replace_with_a_long_random_string_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- OTP ----
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
# When true, the OTP is returned in the API response + logged (DEV ONLY, no SMS provider needed)
OTP_DEV_MODE=true

# ---- SMS provider ----
# provider: console (dev, just logs) | twilio | msg91
SMS_PROVIDER=console
SMS_SENDER_NAME=GlowUp
# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# MSG91 (https://control.msg91.com) — India, requires a DLT-approved template
MSG91_AUTH_KEY=
MSG91_SENDER_ID=GLOWUP
MSG91_TEMPLATE_ID=

# ---- Uploads (artist portfolio images) ----
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=5
# Absolute public base URL of the API (used to build image URLs). Leave blank to use the request host.
PUBLIC_URL=

# ---- Razorpay ----
# Get these from https://dashboard.razorpay.com/app/keys (use test keys for development)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
